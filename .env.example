# Supabase project credentials (v2 — multi-tenant)
# Copy this file to .env and fill in your values from:
# https://supabase.com/dashboard → your project → Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# NOTE: In v2, there is no VITE_ADMIN_PASS, VITE_INVITE_CODE, or VITE_IT_PIN.
# Credentials are stored per-school in the Supabase database:
#   schools.invite_code  — judges enter this
#   schools.admin_pin    — IT/reset PIN
#   Admin login          — Supabase Auth email + password (set via school-register view)
