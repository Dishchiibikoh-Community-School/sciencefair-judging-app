# Supabase project credentials
# Copy this file to .env and fill in your values from:
# https://supabase.com/dashboard → your project → Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# App credentials — set these before deploying, then update in Vercel environment variables
VITE_INVITE_CODE=your-judge-invite-code
VITE_ADMIN_PASS=your-admin-password
VITE_IT_PIN=your-4-digit-it-pin
